# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Service health probes (see README "Service Health Probes")
# HEALTH_PROBE_INTERVAL_MS=30000
# HEALTH_PROBE_TIMEOUT_MS=3000
# HEALTH_PROBE_CONCURRENCY=8
# HEALTH_PROBE_ALLOWED_DOMAINS=kerrlab.app
# HEALTH_PROBE_INSECURE_TLS=false

# Authelia forward-auth & RBAC (see README "Authentication & Access Control")
# AUTH_MODE=forward-auth
# AUTH_ADMIN_GROUPS=admins
# AUTH_VIEWER_CATEGORIES=MEDIA,HOME & LIVING
# Gateway addresses only (never the whole pod CIDR); '*' only with a NetworkPolicy. Unset = fail closed in production.
# AUTH_TRUSTED_PROXIES=192.0.2.10,192.0.2.11
# Local development only (ignored in production):
# AUTH_DEV_USER=dev
# AUTH_DEV_GROUPS=admins
