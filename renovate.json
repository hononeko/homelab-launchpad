{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>hononeko/renovate-config",
    "github>hononeko/renovate-config:hononeko-actions"
  ],
  "packageRules": [
    {
      "groupName": "bun",
      "matchPackageNames": [
        "bun",
        "oven/bun",
        "docker.io/oven/bun",
        "@types/bun",
        "bun-types",
        "oven-sh/setup-bun"
      ]
    },
    {
      "groupName": "docker build actions",
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^docker/"]
    },
    {
      "groupName": "vite",
      "matchPackagePatterns": ["^vite$", "^@vitejs/"]
    }
  ]
}
