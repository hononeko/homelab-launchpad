{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "mergeConfidence:all-badges",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "groupName": "bun",
      "matchPackageNames": [
        "bun",
        "oven/bun",
        "docker.io/oven/bun",
        "@types/bun",
        "bun-types",
        "oven-sh/setup-bun"
      ]
    },
    {
      "groupName": "docker build actions",
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^docker/"]
    },
    {
      "groupName": "vite",
      "matchPackagePatterns": ["^vite$", "^@vitejs/"]
    },
    {
      "description": "Internal hononeko/actions: update immediately without release age delay",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "hononeko/actions",
        "hononeko/actions/**"
      ],
      "matchDepNames": [
        "hononeko/actions",
        "hononeko/actions/**"
      ],
      "minimumReleaseAge": "0 days"
    }
  ]
}
